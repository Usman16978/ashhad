# ── Site ───────────────────────────────────────────────────────
# Canonical URL used for SEO metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Form notifications (optional) ──────────────────────────────
# Create a free account at https://resend.com and verify a domain
# (or use onboarding@resend.dev while testing).
RESEND_API_KEY=
NOTIFICATION_EMAIL=admissions@your-domain.com
MAIL_FROM="Al-Noor Website <notifications@your-domain.com>"
